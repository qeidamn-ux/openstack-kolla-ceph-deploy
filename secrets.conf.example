# secrets.conf — password dei servizi (FACOLTATIVO).
# Senza questo file valgono i default da LABORATORIO (dashboard Ceph e utente demo): sul campo
# si crea, accanto agli script, SOLO sul nodo da cui si lancia la catena (node01):
#
#   cat > secrets.conf <<'EOT'
#   DASHBOARD_PASS="<password-dashboard-ceph>"
#   DEMO_PASS="<password-utente-demo>"
#   EOT
#   chmod 600 secrets.conf
#
# Regole: almeno 8 caratteri; NIENTE apici, virgolette, backslash, $, backtick, spazi
# (finiscono dentro comandi shell e file YAML). Sono usati da 01b (dashboard Ceph, utente admin)
# e da 03 (utente demo del progetto demo). La password admin di OpenStack e' generata a caso
# dal 02 e salvata in /root/admin-openrc-password.txt.
